---
import { Image } from "astro:assets";

const { product, eager = false } = Astro.props;
---

<a href={`/products/${product.name}`} class="group block space-y-4" data-product-card>
  <div
    class="aspect-[4/5] overflow-hidden transition-all duration-300 group-hover:scale-[1.02]"
    style="border-radius: 20px; background: var(--pastel-yellow); box-shadow: 0 8px 30px rgba(255, 249, 196, 0.4);"
  >
    <Image
      src={product.image}
      alt={`${product.name} — ${product.description}`}
      width={1024}
      height={1280}
      loading={eager ? "eager" : "lazy"}
      decoding={eager ? "sync" : "async"}
      format="webp"
      class="h-full w-full object-cover transition-transform duration-[1200ms] ease-out group-hover:scale-[1.05]"
      style="filter: brightness(1.02) saturate(0.95);"
    />
  </div>
  <div class="flex items-start justify-between gap-4">
    <div>
      <h2 class="text-sm font-medium" style="color: var(--ink);">{product.name}</h2>
      <p class="text-xs" style="color: var(--faded);">{product.description}</p>
    </div>
    <span class="text-sm tabular-nums" style="color: var(--accent);">{product.price}€</span>
  </div>
</a>
