---
import "../styles.css";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";

const {
  title = "Saudade — Encuentros en el Camino",
  description = "Una pequeña librería con encanto, where stories meet journeys.",
  image,
  noindex = false,
  includeHeader = true,
  includeFooter = true,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const ogImage = image
  ? new URL(image.src ?? image, Astro.site ?? Astro.url.origin).href
  : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Saudade" />
    <meta name="theme-color" content="#FFFDF7" />
    <link rel="canonical" href={canonicalUrl.href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.jpg" />
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Saudade" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl.href} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <script is:inline>
      const CART_KEY = "saudade:cart";

      window.SaudadeCart = {
        read() {
          try {
            return JSON.parse(localStorage.getItem(CART_KEY) || "[]");
          } catch {
            return [];
          }
        },
        save(cart) {
          localStorage.setItem(CART_KEY, JSON.stringify(cart));
          document.dispatchEvent(new CustomEvent("saudade-cart-change"));
        },
        add(name, quantity = 1) {
          const cart = this.read();
          const existing = cart.find((item) => item.name === name);
          if (existing) {
            existing.quantity += quantity;
          } else {
            cart.push({ name, quantity });
          }
          this.save(cart);
        },
        setQuantity(name, quantity) {
          let cart = this.read();
          if (quantity <= 0) {
            cart = cart.filter((item) => item.name !== name);
          } else {
            const item = cart.find((i) => i.name === name);
            if (item) item.quantity = quantity;
          }
          this.save(cart);
        },
        remove(name) {
          const cart = this.read().filter((item) => item.name !== name);
          this.save(cart);
        },
        clear() {
          localStorage.removeItem(CART_KEY);
          document.dispatchEvent(new CustomEvent("saudade-cart-change"));
        },
      };
    </script>
  </head>
  <body class="bg-base text-ink">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:px-4 focus:py-2 focus:text-sm"
      style="background: var(--pastel-blue); color: var(--ink);"
    >
      Saltar al contenido
    </a>
    {includeHeader && <SiteHeader currentPath={Astro.url.pathname} />}
    <div>
      <slot />
    </div>
    {includeFooter && <SiteFooter />}
  </body>
</html>
