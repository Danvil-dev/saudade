---
import ProductCard from "@/components/ProductCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getProducts, getCategories, getProductsOfCategory } from "@/db/dbFunctions.js";

const products = await getProducts();
const categories = await getCategories();

let selectedCategory = "all";

const productsOfCategory = await getProductsOfCategory(selectedCategory);
---

<BaseLayout title="Saudade" description="Papeleria de Granada">
  <main id="main-content">
    <section class="mx-auto max-w-screen-xl px-6 pb-12 pt-20 md:pb-16 md:pt-28">
      <p class="mb-6 flex items-center gap-3 text-[11px] uppercase tracking-[0.3em] text-faded">
        <span class="inline-block h-px w-8 bg-ink/40"></span>
        Cat&aacute;logo
      </p>
      <h1 class="max-w-[18ch] text-balance font-serif text-5xl leading-[0.95] md:text-6xl">
        Every piece, <span class="italic text-accent">made to order.</span>
      </h1>
      <p class="mt-6 max-w-[52ch] leading-relaxed text-faded">
        Explora nuestro catálogo de productos
      </p>
    </section>

    <div class="mx-auto max-w-screen-xl px-6 pb-32">
      <section class="border-t border-line pb-12 pt-8" aria-label="Catalogue filters">
        <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
          <div class="space-y-4">
            <h2 class="text-xs uppercase tracking-[0.25em] text-faded">
              <span data-catalog-count>{products.length}</span>
              <span data-catalog-count-label>pieces</span>
            </h2>
            <div class="flex flex-wrap items-center gap-2" data-filter-group="category">
              <button
                class="catalog-chip is-active"
                type="button"
                data-filter-value="all"
                aria-pressed="true">All Pieces</button
              >
              {
                categories.map((category) => (
                  <button
                    class="catalog-chip"
                    type="button"
                    data-filter-value={category}
                    aria-pressed="false"
                  >
                    {category}
                  </button>
                ))
              }
            </div>
          </div>
          <label class="flex items-center gap-3 text-xs uppercase tracking-widest text-faded">
            Sort
            <select
              class="border-b border-line bg-transparent py-1 pr-6 text-ink focus:border-ink focus:outline-none"
              data-catalog-sort
            >
              <option value="featured">Featured</option>
              <option value="price-asc">Price · Low to High</option>
              <option value="price-desc">Price · High to Low</option>
            </select>
          </label>
        </div>
      </section>

      <p class="hidden py-32 text-center font-serif text-2xl text-faded" data-catalog-empty>
        No pieces match that combination.
      </p>
      <div
        class="grid grid-cols-1 gap-x-8 gap-y-16 md:grid-cols-2 lg:grid-cols-3"
        data-catalog-grid
      >
        {
          products.map((product, index) => (
            <article
              data-catalog-item
              data-category={product.category}
              data-material={product.material}
              data-price={product.price}
              data-index={index}
            >
              <ProductCard product={product} eager={index < 3} />
            </article>
          ))
        }
      </div>
    </div>

    <style>
      .catalog-chip {
        border-radius: 9999px;
        padding: 0.375rem 1rem;
        font-size: 0.75rem;
        font-weight: 500;
        line-height: 1rem;
        color: var(--color-ink);
        box-shadow: inset 0 0 0 1px var(--color-line);
        transition:
          background-color 180ms ease,
          color 180ms ease,
          box-shadow 180ms ease;
      }

      .catalog-chip:hover {
        background-color: var(--color-paper);
      }

      .catalog-chip.is-active {
        background-color: var(--color-ink);
        color: var(--color-base);
        box-shadow: inset 0 0 0 1px var(--color-ink);
      }
    </style>

    <script is:inline>
      const grid = document.querySelector("[data-catalog-grid]");
      const items = Array.from(document.querySelectorAll("[data-catalog-item]"));
      const countNode = document.querySelector("[data-catalog-count]");
      const countLabel = document.querySelector("[data-catalog-count-label]");
      const empty = document.querySelector("[data-catalog-empty]");
      const sort = document.querySelector("[data-catalog-sort]");

      const filters = { category: "all" };

      function applyFilters() {
        const visible = items.filter((item) => {
          return filters.category === "all" || item.dataset.category === filters.category;
        });

        visible.sort((a, b) => {
          if (sort.value === "price-asc") return Number(a.dataset.price) - Number(b.dataset.price);
          if (sort.value === "price-desc") return Number(b.dataset.price) - Number(a.dataset.price);
          return Number(a.dataset.index) - Number(b.dataset.index);
        });

        items.forEach((item) => (item.hidden = true));
        visible.forEach((item) => {
          item.hidden = false;
          grid.appendChild(item);
        });

        countNode.textContent = String(visible.length);
        countLabel.textContent = visible.length === 1 ? "piece" : "pieces";
        empty.classList.toggle("hidden", visible.length > 0);
        grid.classList.toggle("hidden", visible.length === 0);
      }

      document.querySelectorAll("[data-filter-group]").forEach((group) => {
        group.addEventListener("click", (event) => {
          const button = event.target.closest("button[data-filter-value]");
          if (!button) return;
          const key = group.dataset.filterGroup;
          filters[key] = button.dataset.filterValue;
          group.querySelectorAll("button").forEach((chip) => {
            chip.classList.remove("is-active");
            chip.setAttribute("aria-pressed", "false");
          });
          button.classList.add("is-active");
          button.setAttribute("aria-pressed", "true");
          applyFilters();
        });
      });

      sort.addEventListener("change", applyFilters);
    </script>
  </main>
</BaseLayout>
