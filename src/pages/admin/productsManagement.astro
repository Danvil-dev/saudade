---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getSupabaseServer } from "@/db/supabaseServer";
import { createProduct, getProducts, deleteProduct, editProduct } from "@/db/dbFunctions";
import { Modal } from "accessible-astro-components";

export const prerender = false;
const supabase = getSupabaseServer(Astro);

const {
  data: { user },
  error,
} = await supabase.auth.getUser();

if (!user || error) {
  return Astro.redirect("/login");
}

const PAGE_SIZE = 10; // 10 productos por página
const pageParams = Astro.url.searchParams.get("page"); // Conseguimos de la URL la página en la que estamos
const currentPage = Math.max(1, Number(pageParams) || 1); // Calculamos la página actual

const from = (currentPage - 1) * PAGE_SIZE; // Desde donde
const to = from + PAGE_SIZE - 1; // Hasta donde

// Cogemos los datos de supabase en el rango que hemos calculado (desde donde, hasta donde)
const { data: products, count } = await supabase
  .from("products")
  .select("*", { count: "exact" })
  .range(from, to);

const totalProducts = count || 0; // Calculamos el total de productos que hay
const totalPages = Math.ceil(totalProducts / PAGE_SIZE) || 1; // Calculamos el total de paginas que hay
const maxPage = Math.max(1, totalPages);

if (Number(pageParams) > totalPages)
  return Astro.redirect(`/admin/productsManagement?page=${maxPage}`);

if (Astro.request.method === "POST")
  try {
    const formData = await Astro.request.formData();
    const action = formData.get("action")?.toString();

    if (action === "delete") {
      const productId = Number(formData.get("productId"));
      const result = await deleteProduct(supabase, productId);

      if (result.success) {
        return Astro.redirect(`/admin/productsManagement?page=${currentPage}`);
      }
    } else if (action === "update") {
      const productId = Number(formData.get("productId"));
      const name = formData.get("name")?.toString() || "";
      const description = formData.get("description")?.toString() || "";
      const category = formData.get("category")?.toString() || "";
      const price = Number(formData.get("price")) || 0;

      const imageFile = formData.get("image") as File;
      const fileToUpload = imageFile && imageFile.size > 0 ? imageFile : undefined;

      const result = await editProduct(
        supabase,
        productId,
        { name, description, category, price },
        fileToUpload,
      );

      if (result.success) {
        return Astro.redirect(`/admin/productsManagement?page=${currentPage}`);
      }
    } else {
      const name = formData.get("name")?.toString() || "";
      const description = formData.get("description")?.toString() || "";
      const category = formData.get("category")?.toString() || "";
      const price = Number(formData.get("price")) || 0;

      const imageFile = formData.get("image") as File;
      const fileToUpload = imageFile && imageFile.size > 0 ? imageFile : undefined;

      const result = await createProduct(
        supabase,
        { name, description, category, price },
        fileToUpload,
      );

      if (result.success) {
        return Astro.redirect(`/admin/productsManagement?page=${currentPage}`);
      }
    }
  } catch (e) {
    console.error("Error al procesar el formulario:", e);
  }
---

<BaseLayout>
  <div class="max-w my-10">
    <div class="flex flex-row justify-around items-center">
      <h2>
        {
          totalProducts > 0
            ? `Total: ${totalProducts} ${totalProducts > 1 ? "productos" : "producto"}`
            : "Aún no hay productos"
        }
      </h2>
      <button class="bg-black hover:bg-gray-500 p-2 text-white rounded-sm" id="modalCrear"
        >&plus; Añadir producto</button
      >
    </div>
    <div
      class="relative overflow-x-auto bg-neutral-primary-soft shadow-xs rounded-base border border-default my-5 mx-20"
    >
      <table class="w-full text-sm text-left rtl:text-right text-body">
        <thead
          class="text-sm text-body bg-neutral-secondary-soft border-b rounded-base border-default"
        >
          <tr>
            <th scope="col" class="px-6 py-3 font-medium"> Id del producto </th>
            <th scope="col" class="px-6 py-3 font-medium"> Nombre </th>
            <th scope="col" class="px-6 py-3 font-medium"> Descripcion </th>
            <th scope="col" class="px-6 py-3 font-medium"> Categoria </th>
            <th scope="col" class="px-6 py-3 font-medium"> Imagen </th>
            <th scope="col" class="px-6 py-3 font-medium"> Precio </th>
            <th scope="col" class="px-6 py-3 font-medium"> Opciones </th>
          </tr>
        </thead>
        <tbody>
          {
            (products || []).map((product) => (
              <tr class="bg-neutral-primary border-b border-default">
                <th scope="row" class="px-6 py-4 font-medium text-heading whitespace-nowrap">
                  {product.id}
                </th>
                <td class="px-6 py-4"> {product.name} </td>
                <td class="px-6 py-4"> {product.description} </td>
                <td class="px-6 py-4"> {product.category} </td>
                <td class="px-6 py-4">
                  {product.image != null ? (
                    <img src={product.image} width="60" height="60" alt={product.name} />
                  ) : (
                    "No hay imagen"
                  )}
                </td>
                <td class="px-6 py-4"> {product.price} € </td>
                <td class="px-6 py-4">
                  <div class="flex flex-row items-center">
                    <button
                      class="m-1 p-2 bg-blue-400 hover:bg-blue-600 rounded-sm"
                      id={`modalEditar-${product.id}`}
                    >
                      Editar
                    </button>
                    <form
                      method="POST"
                      class="delete-form"
                    >
                      <input type="hidden" name="action" value="delete" />
                      <input type="hidden" name="productId" value={product.id} />
                      <button
                        type="submit"
                        class="p-2 bg-red-500 hover:bg-red-700 text-white rounded-sm"
                      >
                        Eliminar
                      </button>
                    </form>
                  </div>
                  <Modal triggerId={`modalEditar-${product.id}`} title={`Editar: ${product.name}`}>
                    <form
                      method="POST"
                      enctype="multipart/form-data"
                      class="flex flex-col gap-4 my-4 w-full"
                    >
                      <input type="hidden" name="action" value="update" />
                      <input type="hidden" name="productId" value={product.id} />

                      <div class="w-full">
                        <label for={`name-${product.id}`} class="block mb-1 font-medium">
                          Nombre
                        </label>
                        <input
                          class="w-full bg-gray-100 p-2 rounded border border-gray-300"
                          type="text"
                          name="name"
                          value={product.name}
                        />
                      </div>

                      <div class="w-full">
                        <label for={`description-${product.id}`} class="block mb-1 font-medium">
                          Descripción
                        </label>
                        <textarea
                          class="w-full bg-gray-100 p-2 rounded border border-gray-300"
                          name="description"
                        >
                          {product.description}
                        </textarea>
                      </div>

                      <div class="grid grid-cols-2 gap-4">
                        <div class="w-full">
                          <label for={`category-${product.id}`} class="block mb-1 font-medium">
                            Categoría
                          </label>
                          <input
                            class="w-full bg-gray-100 p-2 rounded border border-gray-300"
                            type="text"
                            name="category"
                            value={product.category}
                          />
                        </div>
                        <div class="w-full">
                          <label for={`price-${product.id}`} class="block mb-1 font-medium">
                            Precio (€)
                          </label>
                          <input
                            class="w-full bg-gray-100 p-2 rounded border border-gray-300"
                            type="number"
                            step="0.01"
                            name="price"
                            value={product.price}
                          />
                        </div>
                      </div>

                      <div class="w-full">
                        <label for={`image-${product.id}`} class="block mb-1 font-medium">
                          Imagen (opcional)
                        </label>
                        <input
                          class="w-full bg-gray-100 p-2 rounded border border-gray-300"
                          type="file"
                          name="image"
                        />
                      </div>

                      <div class="flex justify-end gap-2 mt-4">
                        <button
                          type="button"
                          onclick="closeModal()"
                          class="px-4 py-2 bg-gray-300 rounded hover:bg-gray-400"
                        >
                          Cancelar
                        </button>
                        <button
                          type="submit"
                          class="px-4 py-2 bg-yellow-500 text-white rounded hover:bg-yellow-600"
                        >
                          Guardar cambios
                        </button>
                      </div>
                    </form>
                  </Modal>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
      <div class="flex justify-between items-center px-5 my-4">
        <a
          href={`?page=${currentPage - 1}`}
          class={`px-4 py-2 bg-gray-200 rounded ${currentPage <= 1 ? "pointer-events-none opacity-50" : "hover:bg-gray-300"}`}
        >
          &larr; Anterior
        </a>

        <span>Página <strong>{currentPage}</strong> de {totalPages}</span>

        <a
          href={`?page=${currentPage + 1}`}
          class={`px-4 py-2 bg-gray-200 rounded ${currentPage >= totalPages ? "pointer-events-none opacity-50" : "hover:bg-gray-300"}`}
        >
          Siguiente &rarr;
        </a>
      </div>
    </div>

    <Modal triggerId="modalCrear" title="Nuevo producto:">
      <form method="POST" enctype="multipart/form-data" class="flex flex-col gap-4 my-4 w-full">
        <div class="w-full">
          <label for="name" class="block mb-1 font-medium">Nombre</label>
          <input
            class="w-full bg-gray-100 p-2 rounded border border-gray-300"
            placeholder="Libreta..."
            type="text"
            name="name"
          />
        </div>

        <div class="w-full">
          <label for="description" class="block mb-1 font-medium">Descripción</label>
          <textarea
            class="w-full bg-gray-100 p-2 rounded border border-gray-300"
            placeholder="Libreta de color azul..."
            name="description"></textarea>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div class="w-full">
            <label for="category" class="block mb-1 font-medium">Categoría</label>
            <input
              class="w-full bg-gray-100 p-2 rounded border border-gray-300"
              placeholder="Materiales"
              type="text"
              name="category"
            />
          </div>
          <div class="w-full">
            <label for="price" class="block mb-1 font-medium">Precio (€)</label>
            <input
              class="w-full bg-gray-100 p-2 rounded border border-gray-300"
              placeholder="3.99"
              type="number"
              step="0.01"
              name="price"
            />
          </div>
        </div>

        <div class="w-full">
          <label for="image" class="block mb-1 font-medium">Imagen</label>
          <input
            class="w-full bg-gray-100 p-2 rounded border border-gray-300"
            type="file"
            name="image"
          />
        </div>

        <div class="flex justify-end gap-2 mt-4">
          <button
            type="button"
            onclick="closeModal()"
            class="px-4 py-2 bg-gray-300 rounded hover:bg-gray-400">Cancelar</button
          >
          <button type="submit" class="px-4 py-2 bg-green-600 text-white rounded hover:bg-green-700"
            >Añadir producto</button
          >
        </div>
      </form>
    </Modal>
  </div>
</BaseLayout>

<style is:global>
  .modal {
    max-width: 700px !important;
    width: 90% !important;
  }
</style>
<script>
  import Swal from "sweetalert2";

  document.querySelectorAll(".delete-form").forEach((form) => {
    form.addEventListener("submit", (event) => {
      event.preventDefault();

      Swal.fire({
        title: "¿Quiere borrar este producto?",
        text: "Esta acción es irreversible",
        icon: "error",
        showCancelButton: true,
        confirmButtonText: "Eliminar",
        cancelButtonText: "Cancelar",
      }).then((result) => {
        if (result.isConfirmed) {
          (form as HTMLFormElement).submit();
        }
      });
    });
  });
</script>
