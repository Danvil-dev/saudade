---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getSupabaseServer } from "@/db/supabaseServer";

export const prerender = false;
const supabase = getSupabaseServer(Astro);
const {
  data: { user },
  error,
} = await supabase.auth.getUser();

if (!user || error) {
  return Astro.redirect("/login");
}
---

<BaseLayout>
  <div class="flex flex-col max-w-lg mx-auto max-h-md my-5 bg-white rounded-md shadow-md">
    <div class="flex flex-row max-w items-center justify-between my-5">
      <div class="flex flex-row">
        <img src="/product.svg" alt="products" width="25" height="25" class="mx-5" />
        <p>Gestion de productos</p>
      </div>
      <button class="bg-black hover:bg-gray-500 text-white p-1.5 rounded-md me-5"
        ><a
          href="/admin/productsManagement"
          class="bg-black hover:bg-gray-500 text-white p-1.5 rounded-md"
        >
          Acceder &rarr;
        </a></button
      >
    </div>
    <div class="flex flex-row max-w items-center justify-between my-5">
      <div class="flex flex-row">
        <img src="/purchase.svg" alt="products" width="25" height="25" class="mx-5" />
        <p>Gestion de reservas</p>
      </div>
      <button class="bg-black hover:bg-gray-500 text-white p-1.5 rounded-md me-5"
        ><a
          href="/admin/bookingManagement"
          class="bg-black hover:bg-gray-500 text-white p-1.5 rounded-md"
        >
          Acceder &rarr;
        </a></button
      >
    </div>
  </div>
</BaseLayout>
